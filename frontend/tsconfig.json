{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "noEmit": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "playwright.config.ts", "playwright.demo.config.ts", "playwright.phase5a.config.ts", "tests/**/*.ts", "demo-tests/**/*.ts", "phase5a-tests/**/*.ts"]
}
