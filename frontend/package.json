{
  "name": "paperpilot-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "contracts": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "element-plus": "^2.9.0",
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^3.0.0",
    "openapi-typescript": "^7.6.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.0.0"
  }
}
