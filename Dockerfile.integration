# Opt-in development/test composition; this is not a production image.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY requirements-day0.lock ./
RUN pip install --no-cache-dir -r requirements-day0.lock
ARG PAPERPILOT_LOCAL_EMBEDDING=0
RUN if [ "$PAPERPILOT_LOCAL_EMBEDDING" = 1 ]; then \
      pip install --no-cache-dir 'fastembed==0.9.1'; \
    elif [ "$PAPERPILOT_LOCAL_EMBEDDING" != 0 ]; then exit 1; fi
COPY pyproject.toml ./
COPY backend ./backend
RUN pip install --no-deps .
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.dev_composition:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
