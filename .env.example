PAPERPILOT_ENV=development
# Explicit development identity only; credentials mode requires PostgreSQL and operator setup.
PAPERPILOT_AUTH_MODE=development
# PAPERPILOT_SESSION_IDLE_SECONDS=1800
# PAPERPILOT_SESSION_ABSOLUTE_SECONDS=28800
# PAPERPILOT_AUTH_LOGIN_LIMIT=10
# PAPERPILOT_AUTH_LOGIN_WINDOW_SECONDS=300
# Login limits count all credential attempts per ASGI peer. Configure proxy trust safely;
# with a shared proxy address the limit is shared by all users behind that proxy.
# PAPERPILOT_AUTH_LOGIN_LIMIT=10
# PAPERPILOT_AUTH_LOGIN_WINDOW_SECONDS=300
PAPERPILOT_A_MODE=mock
PAPERPILOT_C_MODE=mock
PAPERPILOT_D_MODE=mock
# Development/isolated testing only. Set required and an independently reviewed
# NOLOGIN audit view owner to enforce the database audit boundary at startup and health checks.
# This check does not establish database-native project isolation.
PAPERPILOT_AUDIT_PREFLIGHT=disabled
# Optional table-operation grant baseline; explicit isolated test mode only.
PAPERPILOT_BUSINESS_PRIVILEGE_PREFLIGHT=disabled
# PAPERPILOT_AUDIT_TRUSTED_OWNER=
# Optional single-user scoped audit path, isolated PostgreSQL test mode only.
# Requires credential authentication, separately provisioned identity and reviewed owners.
# Never place actual passwords in this file; inject them through a protected environment.
# Authentication database split candidate: isolated local PostgreSQL tests only.
# Default shared mode preserves existing development behavior. Never store secrets here.
PAPERPILOT_AUTH_DATABASE=shared
# PAPERPILOT_AUTH_DB_ISOLATED_TEST=1
# PAPERPILOT_AUTH_LOCK_OWNER=  # independently reviewed NOLOGIN function owner
# PAPERPILOT_AUTH_DB_HOST=127.0.0.1
# PAPERPILOT_AUTH_DB_PORT=
# PAPERPILOT_AUTH_DB_DBNAME=
# PAPERPILOT_AUTH_DB_USER=
# PAPERPILOT_AUTH_DB_PASSWORD=  # inject externally, not in tracked files
# Protected absolute secret-file path (choose value OR file, never both).
# POSIX: current owner, no group/other permissions; Windows: local fixed drive, current-user-only protected ACL.
# PAPERPILOT_DATA_PASSWORD_FILE=
# PAPERPILOT_AUTH_DB_PASSWORD_FILE=
# PAPERPILOT_SECURITY_DB_BINDINGS_FILE=
# PAPERPILOT_SECURITY_DB_PASSWORD_FILE=
# PAPERPILOT_SCOPED_AUDIT_BINDINGS_FILE=
# PAPERPILOT_SCOPED_AUDIT_PASSWORD_FILE=
# Multiple statistical project identities: provide PAPERPILOT_SECURITY_DB_BINDINGS
# as protected JSON [{project_id, user, password}, ...] with distinct logins.
# Do not set the single-project PROJECT_ID/USER/PASSWORD variables at the same time.
PAPERPILOT_SCOPED_AUDIT=disabled
# PAPERPILOT_SCOPED_AUDIT_ISOLATED_TEST=1
# PAPERPILOT_SCOPED_AUDIT_HOST=127.0.0.1
# PAPERPILOT_SCOPED_AUDIT_PORT=
# PAPERPILOT_SCOPED_AUDIT_DBNAME=
# PAPERPILOT_SCOPED_AUDIT_USER=
# PAPERPILOT_SCOPED_AUDIT_PASSWORD=
# PAPERPILOT_SCOPED_AUDIT_USER_ID=
# PAPERPILOT_SCOPED_AUDIT_PROJECT_ID=
# PAPERPILOT_SCOPED_AUDIT_OWNER=
# PAPERPILOT_SCOPED_AUDIT_BINDING_OWNER=
# For multiple test identities, inject a JSON array into PAPERPILOT_SCOPED_AUDIT_BINDINGS
# through a protected environment; entries require db_user, db_password, user_id, project_id.
# Do not populate the legacy single-user variables when using the array.
PAPERPILOT_STORAGE_DIR=.runtime/uploads
PAPERPILOT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# A's DataSettings reads this explicitly; it does not register a real DataPort.
PAPERPILOT_LEASE_SECONDS=120
PAPERPILOT_MAX_AUTOMATIC_ATTEMPTS=3
# Demo idempotency records do not expire and are not automatically purged.
# A_MODE=persistent (or real) requires an explicitly registered DataBinding.
# Without A's implementation, startup fails; there is no database default or Mock fallback.
# Database engine, credentials, migration and lease configuration are owned by A/team.
# C_MODE=real requires ai_factory; D_MODE=real requires security_factory at create_app.
# Modes never dynamically load implementations. See docs/development-guide.md.
# Production remains unavailable until real authentication/deployment are delivered.
# Rich synthetic demo data is opt-in: scripts/start-backend.ps1 -Demo
# Or uvicorn app.demo:create_demo_app --factory --app-dir backend (all modes must be mock).
# Normal app.main:create_app and contract tests keep the original minimal fixtures.

# Optional real C: explicitly register app.ai.adapter:build_ai, or use
# uvicorn app.ai.bootstrap:create_app --factory --app-dir backend (C_MODE=real).
# Requires .[ai]; SJTU + local embeddings additionally requires .[ai-local].
# PAPERPILOT_AI_BASE_URL=https://models.sjtu.edu.cn/api/v1
# PAPERPILOT_AI_API_KEY=   # inject the actual secret outside version control
# PAPERPILOT_AI_CHAT_MODEL=deepseek-chat
# PAPERPILOT_AI_EMBEDDING_BACKEND=fastembed
# PAPERPILOT_AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# PAPERPILOT_AI_EMBEDDING_DIMENSIONS=512
# PAPERPILOT_AI_EMBEDDING_REVISION=   # explicit immutable model/weights revision for persistent A+C
# PAPERPILOT_AI_LOCAL_MODEL_DIR=  # explicit prepare_ai_embeddings.py output
# PAPERPILOT_AI_TIMEOUT_SECONDS=45
# PAPERPILOT_AI_CHUNK_STRATEGY=auto  # prepared BGE-small-zh: sentence-token-v2; others: character-v1
# PAPERPILOT_AI_CHUNK_TOKENS=384     # v2 body target; final title+body must fit the model
# PAPERPILOT_AI_CHUNK_TOKEN_OVERLAP=48
# PAPERPILOT_AI_MIN_SIMILARITY=0.2
# PAPERPILOT_AI_TOKEN_LIMIT_PARAMETER=max_tokens
# For remote embeddings (no implicit fallback), set BACKEND=remote and real MODEL/DIMENSIONS.
# PAPERPILOT_AI_EMBEDDING_BASE_URL=  # optional, independent embedding provider
# PAPERPILOT_AI_EMBEDDING_API_KEY=   # optional independent credentials
# Configuration and limitations: docs/ai-adapter.md

# Optional isolated business-data pilot: use only with PAPERPILOT_ENV=test and
# a separately prepared local PostgreSQL test database. Leave every setting
# unset unless running the pilot. The manifest must be a protected local file.
# PAPERPILOT_SCOPED_BUSINESS_ISOLATED_TEST=1
# PAPERPILOT_SCOPED_BUSINESS_BINDINGS_FILE=
# PAPERPILOT_SCOPED_BUSINESS_FUNCTION_OWNER=
# PAPERPILOT_SCOPED_BUSINESS_BINDING_OWNER=
