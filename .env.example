PAPERPILOT_ENV=development
PAPERPILOT_A_MODE=mock
PAPERPILOT_C_MODE=mock
PAPERPILOT_D_MODE=mock
PAPERPILOT_AUTH_MODE=development
PAPERPILOT_STORAGE_DIR=.runtime/uploads
PAPERPILOT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# A's DataSettings reads this explicitly; it does not register a real DataPort.
PAPERPILOT_LEASE_SECONDS=120
PAPERPILOT_MAX_AUTOMATIC_ATTEMPTS=3
# Demo idempotency records do not expire and are not automatically purged.
# A_MODE=persistent (or real) requires an explicitly registered DataBinding.
# Without A's implementation, startup fails; there is no database default or Mock fallback.
# Database engine, credentials, migration and lease configuration are owned by A/team.
# C_MODE=real requires ai_factory; D_MODE=real requires security_factory at create_app.
# Modes never dynamically load implementations. See docs/development-guide.md.
# Local HTTPS/password deployment: docs/local-deployment.md; development mode never validates passwords.
# Passwords also support an absolute *_FILE reference; setting both forms is refused.
# Rich synthetic demo data is opt-in: scripts/start-backend.ps1 -Demo
# Or uvicorn app.demo:create_demo_app --factory --app-dir backend (all modes must be mock).
# Normal app.main:create_app and contract tests keep the original minimal fixtures.

# Optional real C: explicitly register app.ai.adapter:build_ai, or use
# uvicorn app.ai.bootstrap:create_app --factory --app-dir backend (C_MODE=real).
# Requires .[ai]; SJTU + local embeddings additionally requires .[ai-local].
# PAPERPILOT_AI_BASE_URL=https://models.sjtu.edu.cn/api/v1
# PAPERPILOT_AI_API_KEY=   # inject the actual secret outside version control
# PAPERPILOT_AI_API_KEY_FILE=  # alternative absolute private secret file; never set both
# PAPERPILOT_AI_CHAT_MODEL=deepseek-chat
# PAPERPILOT_AI_EMBEDDING_BACKEND=fastembed
# PAPERPILOT_AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# PAPERPILOT_AI_EMBEDDING_DIMENSIONS=512
# PAPERPILOT_AI_EMBEDDING_REVISION=   # explicit immutable model/weights revision for persistent A+C
# PAPERPILOT_AI_LOCAL_MODEL_DIR=  # explicit prepare_ai_embeddings.py output
# PAPERPILOT_AI_TIMEOUT_SECONDS=45
# PAPERPILOT_AI_MIN_SIMILARITY=0.2
# PAPERPILOT_AI_TOKEN_LIMIT_PARAMETER=max_tokens
# For remote embeddings (no implicit fallback), set BACKEND=remote and real MODEL/DIMENSIONS.
# PAPERPILOT_AI_EMBEDDING_BASE_URL=  # optional, independent embedding provider
# PAPERPILOT_AI_EMBEDDING_API_KEY=   # optional independent credentials
# Configuration and limitations: docs/ai-adapter.md
