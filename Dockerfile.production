ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}
WORKDIR /app
COPY requirements-production.lock ./
RUN pip install --no-cache-dir -r requirements-production.lock
COPY pyproject.toml ./
COPY backend/app ./backend/app
RUN pip install --no-deps . && useradd --uid 10001 --no-create-home app
ARG SOURCE_FINGERPRINT
ENV PAPERPILOT_SOURCE_FINGERPRINT=${SOURCE_FINGERPRINT} PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
LABEL org.paperpilot.source-fingerprint=${SOURCE_FINGERPRINT}
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.production:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers", "--no-access-log"]
